# Application Configuration
APP_NAME=Web API
APP_VERSION=1.0.0
APP_DESCRIPTION=Modern Web Application API

# Database Configuration
DATABASE_URL=sqlite:///./app.db
DATABASE_ECHO=False

# Security
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# Frontend URL
FRONTEND_URL=http://localhost:5173

# Email delivery (587/starttls or 465/ssl)
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=starttls
# Optional phone verification adapter
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_VERIFY_SERVICE_SID=

# Password recovery uses a separate Twilio Verify service from phone verification.
TWILIO_RECOVERY_SERVICE_SID=
RECOVERY_SMS_ENABLED=False
RECOVERY_WHATSAPP_ENABLED=False

# Verified automatic SQLite snapshots, private to the server.
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=30
# BACKUP_DIR=/data/backups
